generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

enum CampaignType {
  WELCOME_DISCOUNT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum PopupTemplate {
  SPLIT_IMAGE
  CENTERED_MINIMAL
  IMAGE_BANNER
}

enum EmailStatus {
  PENDING
  // Legacy: the custom "Welcome Offer Claimed" Flow trigger fired. No longer written.
  TRIGGERED
  // Legacy: no longer written.
  SENT
  FAILED
  // Legacy: replaced by emailEligibility. No longer written.
  NOT_SUBSCRIBED
  // Customer, code, metafields and the trekiva_welcome_claimed tag all exist: Shopify Flow owns delivery now.
  READY_FOR_FLOW
  // Flow added trekiva_welcome_email_sent (Flow ran its email action).
  EMAIL_SENT
  // Instant apply: the code was handed to the customer's browser at signup, no email involved.
  APPLIED
}

// Who sends this claim's email. Fixed when the claim is created, so switching modes later never
// emails an already-handled claim a second time.
enum EmailDelivery {
  // Shopify Flow sends it (the app adds the tag that starts the workflow).
  FLOW
  // The app sends it itself through Resend.
  APP
  // No email at all: the discount is applied in the customer's browser when they submit the popup.
  INSTANT
}

// Whether Shopify Email may send marketing email to this customer. Separate from the claim itself:
// an unsubscribed customer still holds a valid code.
enum EmailEligibility {
  SUBSCRIBED
  NOT_SUBSCRIBED
  UNKNOWN
}

model Campaign {
  id            String         @id @default(cuid())
  shopDomain    String         @map("shop_domain")
  name          String
  type          CampaignType   @default(WELCOME_DISCOUNT)
  status        CampaignStatus @default(DRAFT)
  template      PopupTemplate  @default(SPLIT_IMAGE)

  // Existing Shopify native discount (never created by this app).
  discountId    String?        @map("discount_id")
  discountCode  String?        @map("discount_code")
  discountTitle String?        @map("discount_title")

  // Validated with zod in app/campaigns (versioned via schemaVersion inside each document).
  content       Json
  design        Json
  rules         Json
  // Legacy inline email template (before shop-level templates). Read only by the migration that moved it.
  email         Json           @default("{}")
  // The welcome email this campaign sends. Null = the built-in default template.
  emailTemplateId String?      @map("email_template_id")
  emailTemplate EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: Restrict)

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  claims        WelcomeOfferClaim[]

  @@index([shopDomain, status])
  @@map("campaigns")
}

/** A reusable welcome email, edited under "Email templates" and picked by campaigns. */
model EmailTemplate {
  id         String     @id @default(cuid())
  shopDomain String     @map("shop_domain")
  name       String
  // Subject, preview text, brand and sections. Validated with zod in app/email/schema.ts.
  template   Json
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  campaigns  Campaign[]

  @@index([shopDomain])
  @@map("email_templates")
}

model WelcomeOfferClaim {
  id                String      @id @default(cuid())
  shopDomain        String      @map("shop_domain")
  campaignId        String      @map("campaign_id")
  shopifyCustomerId String?     @map("shopify_customer_id")
  emailNormalized   String      @map("email_normalized")
  // This claim's own code, added to the campaign's Shopify discount.
  discountCode      String      @map("discount_code")
  claimedAt         DateTime    @default(now()) @map("claimed_at")
  // Legacy (custom Flow trigger). Read only so claims settled before the tag handoff stay settled.
  flowTriggeredAt   DateTime?   @map("flow_triggered_at")
  // Set once customer, code, metafields and tag exist. The point of no return: a claim past it is never retried.
  flowHandoffAt     DateTime?   @map("flow_handoff_at")
  emailSentAt       DateTime?   @map("email_sent_at")
  emailStatus       EmailStatus @default(PENDING) @map("email_status")
  emailEligibility  EmailEligibility @default(UNKNOWN) @map("email_eligibility")
  delivery          EmailDelivery @default(FLOW) @map("delivery")
  // The popup's explicit marketing checkbox, kept so a retry reuses the original consent.
  marketingConsent  Boolean     @default(false) @map("marketing_consent")
  // Set when an order used this claim's code; the code is then removed from the Shopify discount so
  // it cannot buy a second order. Cleared (and the code restored) if that order is cancelled.
  redeemedAt        DateTime?   @map("redeemed_at")
  redeemedOrderId   String?     @map("redeemed_order_id")
  // Why the last fulfilment attempt failed (customer | discount | metafields | tag). Cleared on success.
  failureStep       String?     @map("failure_step")
  failureReason     String?     @map("failure_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  campaign          Campaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  // The single source of truth for "one email, one claim per campaign".
  @@unique([shopDomain, campaignId, emailNormalized], map: "welcome_offer_claims_unique_email_per_campaign")
  // A redeem code is unique per shop in Shopify, so two claims must never share one: a
  // collision would hand a second customer a code that is already spent.
  @@unique([shopDomain, discountCode], map: "welcome_offer_claims_unique_code_per_shop")
  @@index([shopDomain, claimedAt])
  @@index([campaignId])
  @@index([shopDomain, shopifyCustomerId])
  @@map("welcome_offer_claims")
}
